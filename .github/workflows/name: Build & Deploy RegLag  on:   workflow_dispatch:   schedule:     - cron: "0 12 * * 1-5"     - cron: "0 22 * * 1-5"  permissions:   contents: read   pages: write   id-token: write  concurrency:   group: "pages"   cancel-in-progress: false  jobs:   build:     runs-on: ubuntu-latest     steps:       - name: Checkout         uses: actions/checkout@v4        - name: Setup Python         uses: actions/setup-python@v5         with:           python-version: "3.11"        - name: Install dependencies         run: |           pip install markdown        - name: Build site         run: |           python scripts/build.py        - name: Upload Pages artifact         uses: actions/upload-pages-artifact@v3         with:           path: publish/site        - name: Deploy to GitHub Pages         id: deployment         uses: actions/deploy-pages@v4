name: Build & Deploy RegLag

on:
  workflow_dispatch:
  schedule:
    - cron: "0 12 * * 1-5"
    - cron: "0 22 * * 1-5"

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
      STRIPE_API_KEY: ${{ secrets.STRIPE_API_KEY }}
      STRIPE_PRICE_ID: ${{ secrets.STRIPE_PRICE_ID }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Extract regulatory_site package
        run: |
          unzip -o regulatory_site_package.zip -d .

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f regulatory_site/requirements.txt ]; then pip install -r regulatory_site/requirements.txt; fi

      - name: Determine run type
        id: runtype
        run: |
          HOUR=$(date -u "+%H")
          if [ "$HOUR" = "22" ]; then echo "RUN_TYPE=later" >> $GITHUB_ENV; else echo "RUN_TYPE=morning" >> $GITHUB_ENV; fi

      - name: Build site
        run: |
          echo "Running RegLag build with RUN_TYPE=$RUN_TYPE"
          if [ "$RUN_TYPE" = "morning" ]; then export BACKFILL_DAYS=90; fi
          python regulatory_site/build_site.py

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: regulatory_site/site

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
